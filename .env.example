# Mẫu biến môi trường cho website + MCP trên VPS (copy thành .env rồi điền giá trị thật)
# KHÔNG commit file .env

# Website (server.js)
PORT=3000
HOST=127.0.0.1
# brain.db dùng chung cho website + MCP (đặt trong thư mục data/ để service ghi được)
BRAIN_DB_PATH=/opt/my-website/data/brain.db
# Đăng nhập trang /admin
ADMIN_USER=admin
ADMIN_PASSWORD=dat-mat-khau-manh

# MCP server my-business (mcp/server.mjs)
MCP_PORT=3001
# IP cầu nối Docker: chỉ goClaw (chạy trong Docker) và chính VPS gọi được, Internet không thấy
MCP_HOST=172.17.0.1
SITE_URL=https://tiemchena.life
# (Tùy chọn) bắt buộc header Authorization: Bearer <MCP_TOKEN>
MCP_TOKEN=
